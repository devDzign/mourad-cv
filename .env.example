# Copiez ce fichier en .env (en local) ou ajoutez ces variables sur Render.
# Sans ces variables, les messages sont seulement enregistrés dans data/messages.json.

# Exemple Gmail : activez la validation en 2 étapes puis créez un « mot de passe d'application »
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=votre.adresse@gmail.com
SMTP_PASS=mot-de-passe-application

# Adresse qui reçoit les messages du formulaire
CONTACT_TO=votre.adresse@gmail.com
